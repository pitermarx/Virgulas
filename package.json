{
    "name": "virgulas",
    "version": "2.2.0",
    "description": "Local-first browser outliner",
    "type": "module",
    "scripts": {
        "dev": "bun scripts/build-bun.mjs source dist --local && bun scripts/serve-bun.mjs dist",
        "dev:test": "bun scripts/build-bun.mjs source dist --test-hooks --local && bun scripts/serve-bun.mjs dist",
        "build": "bun scripts/build-bun.mjs source dist --no-sourcemap",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
        "test": "bun run test:unit && bun run test:e2e",
        "test:unit": "bun test tests/unit",
        "test:e2e": "bunx playwright test",
        "sw:bump": "bun scripts/bump-sw-caches.mjs",
        "sw:hooks": "bun scripts/install-hooks.mjs",
        "commit:check": "bun scripts/check-conventional-commits.mjs",
        "db:start": "supabase start --ignore-health-check",
        "db:stop": "supabase stop --no-backup --yes",
        "postinstall": "bun scripts/bump-sw-caches.mjs"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.14.5",
        "@playwright/test": "^1.63.0",
        "@types/bun": "^1.4.2",
        "happy-dom": "^20.14.5",
        "supabase": "^2.117.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@preact/signals": "^2.11.2",
        "@supabase/supabase-js": "^2.116.0",
        "dompurify": "^3.4.15",
        "htm": "^3.1.1",
        "marked": "^18.0.12",
        "preact": "^10.29.8"
    }
}
